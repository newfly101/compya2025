# cp env.local .env
#
# 로컬 개발 PC 용 환경변수 템플릿.
# 이 파일을 .env 로 복사한 뒤 본인 환경에 맞게 값 채워서 build / bootRun.
# .env 는 .gitignore 됨 — 안전하게 시크릿 채워도 됨.
# Spring Boot 가 application.properties:27 의 spring.config.import 로 .env 자동 import.

# ── Database (MariaDB) ──
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=compyafun
DB_USERNAME=
DB_PASSWORD=

# ── Naver OAuth ──
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=http://localhost:8080/api/auth/naver/callback

# ── JWT (HS256, 32 bytes 이상 권장. 생성 예: openssl rand -base64 64) ──
JWT_SECRET=

# ── AWS S3 ──
AWS_CREDENTIALS_ACCESS_KEY=
AWS_CREDENTIALS_SECRET_KEY=
AWS_REGION_STATIC_VALUE=ap-northeast-2
AWS_S3_BUCKET=
AWS_S3_URL=

# ── Swagger ──
SWAGGER_UI_ENABLED=true
