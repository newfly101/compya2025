# cp env.prod .env
#
# 운영 배포 환경 변수 템플릿.
# 이 파일을 .env 로 복사한 뒤 운영 시크릿 채워서 배포.
# .env 는 .gitignore 됨 — 운영 자격증명/시크릿을 절대 git 에 올리지 말 것.
# 시크릿은 가급적 시크릿 매니저(AWS Secrets Manager / SSM) 에 두고
# 컨테이너/서버 시작 시 .env 로 주입하는 방식 권장.

# ── Database (MariaDB) ──
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

# ── Naver OAuth ──
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=https://api.compyafun.com/api/auth/naver/callback

# ── JWT (HS256, 32 bytes 이상. 생성 예: openssl rand -base64 64) ──
JWT_SECRET=

# ── AWS S3 ──
AWS_CREDENTIALS_ACCESS_KEY=
AWS_CREDENTIALS_SECRET_KEY=
AWS_REGION_STATIC_VALUE=ap-northeast-2
AWS_S3_BUCKET=
AWS_S3_URL=

# ── Swagger (운영 비활성) ──
SWAGGER_UI_ENABLED=false
