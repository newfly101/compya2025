<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.dawne.com2usbaseball.domain.fun.playerCard.repository.mapper.PlayerCardMapper">

    <resultMap id="PlayerCardResultMap"
               type="com.dawne.com2usbaseball.domain.fun.playerCard.entity.PlayerCardEntity">
        <result property="playerName" column="player_name"/>
        <result property="teamCode" column="team_code"/>
        <result property="seasonYear" column="season_year"/>
        <result property="playerRole" column="player_role"/>
        <result property="positionCode" column="position_code"/>
        <result property="subPositionCode" column="sub_position_code"/>
        <result property="hasSignature" column="has_signature"/>
        <result property="legendName" column="legend_name"/>
    </resultMap>

    <!--
      NORMAL 카드 11,668건 전량 + 레전드 재료 여부(LEFT JOIN).
      legend_name 이 NULL 이면 재료가 아닌 카드다.

      card_id(UUID) 는 뽑지 않는다 — 응답 용량의 80% 를 차지해서 뺀 것과 같은 이유로,
      여기서도 select 목록에 넣지 않는다(뽑아봐야 응답에서 버려질 값).

      material_type='PLAYER' 인 재료 행은 player_card_id 로 카드 1건에 유일하게 연결된다
      (ADD_MATERIAL_CARD_ID.sql 444건 연결, 카드 하나가 두 레전드의 재료인 경우 실측 0건 —
      늘어나면 행이 11,668 을 넘으므로 PlayerCardMapperTest 가 그걸 잡는다).
    -->
    <select id="findAll" resultMap="PlayerCardResultMap">
        SELECT c.player_name,
               c.team_code,
               c.season_year,
               c.player_role,
               c.position_code,
               c.sub_position_code,
               c.has_signature,
               l.legend_name
        FROM data_player_card c
                 LEFT JOIN data_player_legend_material m ON m.player_card_id = c.id
                 LEFT JOIN data_player_legend l ON l.id = m.legend_id
        WHERE c.card_type = 'NORMAL'
        ORDER BY c.team_code, c.season_year, c.position_code, c.player_name
    </select>

    <!--
      구단 하나(전체 연도)의 스탯 + 구종. card_id(UUID) 는 뽑지 않는다 — findAll 과 같은 이유로,
      (team_code, season_year, position_code, player_name) 4개가 이 조회 범위(NORMAL 카드만)에서
      이미 유일해 MyBatis 그룹핑 키로 충분하다.

      data_player_card_stat 은 NORMAL 카드 1건당 정확히 1행이라 INNER JOIN 으로 붙인다
      (붙는 행이 없으면 그 카드는 스탯 미적재 상태이므로 애초에 응답에서 빠지는 게 맞다).
      구종은 보유한 것만 LEFT JOIN 으로 붙고, data_pitch_type 은 정렬 순서(sort_no) 용도로만 조인한다.
    -->
    <resultMap id="PlayerCardStatResultMap"
               type="com.dawne.com2usbaseball.domain.fun.playerCard.entity.PlayerCardStatEntity">
        <id property="teamCode" column="team_code"/>
        <id property="seasonYear" column="season_year"/>
        <id property="positionCode" column="position_code"/>
        <id property="playerName" column="player_name"/>
        <result property="playerRole" column="player_role"/>
        <result property="stat1" column="stat1"/>
        <result property="stat2" column="stat2"/>
        <result property="stat3" column="stat3"/>
        <result property="stat4" column="stat4"/>
        <result property="stat5" column="stat5"/>

        <collection property="pitches"
                    ofType="com.dawne.com2usbaseball.domain.fun.playerCard.entity.PlayerCardPitchEntity">
            <id property="pitchCode" column="pitch_code"/>
            <result property="pitchGrade" column="pitch_grade"/>
        </collection>
    </resultMap>

    <select id="findStatsByTeamCode" resultMap="PlayerCardStatResultMap">
        SELECT c.team_code,
               c.season_year,
               c.position_code,
               c.player_name,
               c.player_role,
               s.stat1,
               s.stat2,
               s.stat3,
               s.stat4,
               s.stat5,
               p.pitch_code,
               p.pitch_grade
        FROM data_player_card c
                 JOIN data_player_card_stat s ON s.card_id = c.id
                 LEFT JOIN data_player_card_pitch p ON p.card_id = c.id
                 LEFT JOIN data_pitch_type t ON t.pitch_code = p.pitch_code
        WHERE c.card_type = 'NORMAL'
          AND c.team_code = #{teamCode}
        ORDER BY c.season_year, c.position_code, c.player_name, t.sort_no
    </select>

    <select id="findDistinctTeamCodes" resultType="java.lang.String">
        SELECT DISTINCT team_code
        FROM data_player_card
        WHERE card_type = 'NORMAL'
        ORDER BY team_code
    </select>

</mapper>
